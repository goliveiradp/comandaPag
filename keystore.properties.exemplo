# Copie este arquivo para keystore.properties (que NÃO vai para o Git) e preencha.
# Crie a chave no Android Studio: Build > Generate Signed Bundle / APK > APK > Create new...
# Guarde o .jks e as senhas com backup: sem eles não dá para atualizar o app nas maquininhas.
storeFile=../chave-comandapag.jks
storePassword=SUA_SENHA_DO_ARQUIVO
keyAlias=comandapag
keyPassword=SUA_SENHA_DA_CHAVE
